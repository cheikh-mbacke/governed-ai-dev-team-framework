{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntegrationMerge",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "work_unit_id",
    "worker_lease_id",
    "epoch",
    "integration_branch",
    "conflict_resolution_attempts",
    "revalidation_passed",
    "revalidation_evidence",
    "merged_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MERGE-[A-Za-z0-9._-]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-Za-z0-9._-]+$"
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_lease_id": {
      "type": "string",
      "pattern": "^LEASE-[A-Za-z0-9._-]+$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "integration_branch": {
      "type": "string",
      "minLength": 1
    },
    "conflict_resolution_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "revalidation_passed": {
      "const": true
    },
    "revalidation_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "merged_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
