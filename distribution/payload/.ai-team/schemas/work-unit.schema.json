{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkUnit",
  "type": "object",
  "required": [
    "id",
    "title",
    "objective",
    "scope",
    "expected_behavior",
    "acceptance_criteria",
    "dependencies",
    "risk",
    "required_verification",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WU-[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "type": "array",
          "description": "Path/glob patterns for product writes (e.g. src/**). Free-form prose labels are ignored by the execution boundary and should live in title/objective instead.",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "description": "Path/glob patterns that remain forbidden even when matched by include or allowed_paths. Free-form prose is ignored by the boundary.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 1
    },
    "member_id": {
      "description": "Ensemble member this Work Unit writes. Omitted or null in standalone and integration Work Units.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "kind": {
      "description": "product writes one member Git; integration must not write product code.",
      "enum": ["product", "integration"]
    },
    "zone": {
      "type": "object",
      "required": [
        "area"
      ],
      "properties": {
        "area": {
          "type": "string",
          "enum": [
            "frontend",
            "backend",
            "fullstack",
            "mobile",
            "infra",
            "data",
            "unknown"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "applicable_rules_requirements": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": { "type": "string" }
          }
        ]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": { "type": "string" }
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_verification": {
      "type": "object",
      "properties": {
        "unit_tests": {
          "type": "boolean"
        },
        "integration_tests": {
          "type": "boolean"
        },
        "contract_tests": {
          "type": "boolean"
        },
        "e2e": {
          "type": "boolean"
        },
        "qa": {
          "type": "boolean"
        },
        "review": {
          "type": "boolean"
        },
        "security_review": {
          "type": "boolean"
        },
        "accessibility_check": {
          "type": "boolean"
        },
        "audit": {
          "type": "boolean"
        },
        "human_acceptance": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "human_ui_review": {
      "type": "object",
      "required": ["required", "reason", "surface"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {
          "enum": [
            "first_testable_slice",
            "new_user_journey",
            "information_architecture_change",
            "critical_user_journey",
            "high_product_ambiguity",
            "material_surface_change",
            "not_required"
          ]
        },
        "surface": {"type": ["string", "null"]},
        "planned_after": {"enum": ["qa"]},
        "blocking_behavior": {
          "enum": ["non_blocking", "pause_affected_surface_when_supervised"]
        }
      },
      "additionalProperties": false
    },
    "context_package_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "waiting_decision",
        "blocked",
        "verification",
        "review",
        "audit",
        "human_test",
        "remediation_required",
        "done",
        "cancelled"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "outcomes": {
      "type": "object",
      "properties": {
        "review_status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "changes_requested"
          ]
        },
        "audit_status": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "passed",
            "failed"
          ]
        },
        "human_acceptance": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "pending",
            "passed",
            "accepted",
            "partially_accepted",
            "rejected",
            "remediation_required"
          ]
        },
        "human_feedback": {
          "type": "array",
          "items": {"type": "string", "pattern": "^HF-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "critical_open_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defects": {
          "type": "array"
        },
        "audit_findings": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
