{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstanceCatalog",
  "type": "object",
  "required": [
    "schema_version",
    "instance_id",
    "ensembles"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "ensembles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "composition": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CR-[A-Za-z0-9._-]+$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
