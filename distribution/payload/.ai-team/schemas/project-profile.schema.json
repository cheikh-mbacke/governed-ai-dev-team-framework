{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectProfile",
  "type": "object",
  "required": [
    "project",
    "autonomy",
    "paths",
    "commands",
    "runtime_environments",
    "release",
    "human_authorities",
    "setup_status"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "repository_kind"
      ]
    },
    "autonomy": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "preset": {
          "enum": [
            "supervised_copilots",
            "unattended_conservative",
            "unattended_extended",
            "unattended_maximal",
            "custom"
          ],
          "description": "Named autonomy preset. Legacy level remains accepted only as compatibility input."
        },
        "level": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "communication": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "email": {
          "type": "object",
          "required": ["enabled", "from", "transport", "recipients", "events"],
          "properties": {
            "enabled": {"type": "boolean"},
            "from": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"},
            "transport": {
              "type": "object",
              "required": ["host", "port", "security", "username", "password_env"],
              "properties": {
                "host": {"type": "string", "minLength": 1},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "security": {"enum": ["ssl", "starttls", "none"]},
                "username": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"},
                "password_env": {"type": "string", "minLength": 1},
                "connect_timeout_seconds": {"type": "number", "minimum": 1, "maximum": 120}
              },
              "additionalProperties": false
            },
            "recipients": {
              "type": "object",
              "required": ["critical", "action_required", "digest"],
              "properties": {
                "critical": {"type": "array", "items": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"}, "uniqueItems": true},
                "action_required": {"type": "array", "items": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"}, "uniqueItems": true},
                "digest": {"type": "array", "items": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"}, "uniqueItems": true}
              },
              "additionalProperties": false
            },
            "events": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "global_stop",
                  "decision_required",
                  "risk_escalation",
                  "release_candidate_ready",
                  "acceptance_ready",
                  "ui_checkpoint",
                  "human_feedback_reconciled",
                  "run_completed"
                ]
              },
              "additionalProperties": {"enum": ["immediate", "digest", "off", "profile"]}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object"
    },
    "commands": {
      "type": "object"
    },
    "runtime_environments": {
      "type": "object"
    },
    "release": {
      "type": "object"
    },
    "human_authorities": {
      "type": "object"
    },
    "setup_status": {
      "type": "object"
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "project_ref": {"type": ["string", "null"], "pattern": "^PRJ-[a-f0-9]{32}$"},
        "collection": {"enum": ["disabled", "consented_share"]},
        "submit_url": {"type": ["string", "null"]},
        "terms_version": {"type": ["string", "null"]},
        "terms_accepted_at": {"type": ["string", "null"], "format": "date-time"},
        "raw_log_retention_days": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
