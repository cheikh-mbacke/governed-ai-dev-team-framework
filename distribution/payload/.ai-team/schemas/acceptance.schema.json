{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanAcceptance",
  "type": "object",
  "required": [
    "id",
    "scenarios",
    "human_result",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "release_or_increment": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose": {
      "enum": ["final_acceptance", "formative_ui_review"]
    },
    "work_unit": {
      "type": ["string", "null"]
    },
    "surface": {
      "type": ["string", "null"]
    },
    "code_revision": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "environment": {
      "type": "string"
    },
    "preconditions": {
      "type": "array"
    },
    "scenarios": {
      "type": "array"
    },
    "human_result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "partial"
          ]
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
