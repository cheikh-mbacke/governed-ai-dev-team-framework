{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunAuthorizationGrant",
  "type": "object",
  "required": [
    "id",
    "revision",
    "issued_at",
    "issuing_authority",
    "work_unit_ids",
    "expires_at",
    "maximum_uses",
    "uses_count",
    "excluded_actions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^GRANT-[A-Za-z0-9._-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "minLength": 1
    },
    "issuing_authority": {
      "type": "string",
      "minLength": 1
    },
    "work_unit_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowed_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_environments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_shell_commands": {
      "type": "array",
      "items": {"type": "string"}
    },
    "allowed_paths": {
      "type": "array",
      "items": {"type": "string"}
    },
    "accessible_secrets": {
      "type": "array",
      "items": {"type": "string"}
    },
    "maximum_spend": {
      "type": [
        "number",
        "null"
      ]
    },
    "maximum_duration_hours": {
      "type": [
        "number",
        "null"
      ]
    },
    "maximum_tokens": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "spend_used": {
      "type": "number",
      "minimum": 0
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "maximum_uses": {
      "type": "integer",
      "minimum": 1
    },
    "uses_count": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "revoked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_menu": {
      "type": "array",
      "description": "Document 6 §5.2 — typed, machine-verifiable anticipated forks; never free text.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "trigger",
          "authorized_option",
          "scope",
          "maximum_uses",
          "expires_at",
          "required_evidence",
          "uses_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "conditions": {
                "type": "object"
              }
            }
          },
          "authorized_option": {
            "type": "object",
            "required": [
              "option_id"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "scope": {
            "type": "object",
            "properties": {
              "work_units": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "environments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "maximum_uses": {
            "type": "integer",
            "minimum": 1
          },
          "uses_count": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "decision_menu_version": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mission_artifact_ids": {
      "type": "array",
      "description": "Document 6 §6.1/§8 — mission artifacts this grant relies on, each already approved by an independent challenge.",
      "items": {
        "type": "string"
      }
    },
    "mission_contract_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "mission_artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "autonomy_preset": {
      "type": ["string", "null"]
    },
    "effective_autonomy_policy": {
      "type": ["object", "null"]
    },
    "effective_autonomy_policy_hash": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
