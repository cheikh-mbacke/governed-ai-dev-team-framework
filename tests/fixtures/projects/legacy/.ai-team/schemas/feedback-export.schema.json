{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameworkFeedbackExport",
  "type": "object",
  "required": [
    "format_version",
    "export_id",
    "generated_at",
    "detail_level",
    "project_ref",
    "framework_version",
    "constitution_version",
    "summary",
    "observations",
    "retrospectives",
    "executions"
  ],
  "properties": {
    "format_version": {"const": "1.2"},
    "export_id": {"type": "string", "pattern": "^EXP-[A-Za-z0-9._-]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "detail_level": {"enum": ["aggregate", "structured", "full"]},
    "project_ref": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "framework_version": {"type": "string", "minLength": 1},
    "constitution_version": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": ["total", "open", "by_category", "by_origin", "by_severity"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "open": {"type": "integer", "minimum": 0},
        "occurrences": {"type": "integer", "minimum": 0},
        "by_category": {"type": "object", "additionalProperties": {"type": "integer"}},
        "by_origin": {"type": "object", "additionalProperties": {"type": "integer"}},
        "by_severity": {"type": "object", "additionalProperties": {"type": "integer"}},
        "signals": {"$ref": "#/$defs/signals"},
        "retrospectives": {"type": "integer", "minimum": 0},
        "executions": {"$ref": "#/$defs/executionSummary"}
      },
      "additionalProperties": false
    },
    "observations": {"type": "array"},
    "retrospectives": {"type": "array"},
    "executions": {"type": "array"},
    "transmission": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["pending", "transmitted", "failed", "local_outbox", "skipped"]
        },
        "submitted_at": {"type": ["string", "null"], "format": "date-time"},
        "destination": {"type": ["string", "null"]},
        "ack_id": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"detail_level": {"const": "aggregate"}},
        "required": ["detail_level"]
      },
      "then": {
        "properties": {
          "observations": {"type": "array", "maxItems": 0},
          "retrospectives": {"type": "array", "maxItems": 0},
          "executions": {"type": "array", "maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"detail_level": {"const": "structured"}},
        "required": ["detail_level"]
      },
      "then": {
        "properties": {
          "observations": {
            "type": "array",
            "items": {"$ref": "#/$defs/structuredObservation"}
          },
          "retrospectives": {
            "type": "array",
            "items": {"$ref": "#/$defs/structuredRetrospective"}
          },
          "executions": {
            "type": "array",
            "items": {"$ref": "#/$defs/structuredExecution"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"detail_level": {"const": "full"}},
        "required": ["detail_level"]
      },
      "then": {
        "properties": {
          "observations": {
            "type": "array",
            "items": {"$ref": "#/$defs/fullObservation"}
          },
          "retrospectives": {
            "type": "array",
            "items": {"$ref": "#/$defs/fullRetrospective"}
          },
          "executions": {
            "type": "array",
            "items": {"$ref": "#/$defs/fullExecution"}
          }
        }
      }
    }
  ],
  "$defs": {
    "signals": {
      "type": "object",
      "required": ["blocked_minutes", "rework_observations", "human_interventions"],
      "properties": {
        "blocked_minutes": {"type": "integer", "minimum": 0},
        "rework_observations": {"type": "integer", "minimum": 0},
        "human_interventions": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "executionSummary": {
      "type": "object",
      "required": [
        "total",
        "terminal",
        "by_status",
        "by_step",
        "duration_ms",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cost"
      ],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "terminal": {"type": "integer", "minimum": 0},
        "by_status": {"type": "object", "additionalProperties": {"type": "integer"}},
        "by_step": {"type": "object", "additionalProperties": {"type": "integer"}},
        "duration_ms": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cost": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "structuredImpact": {
      "type": "object",
      "required": [
        "blocked_minutes",
        "rework_required",
        "human_intervention",
        "affected_work_unit_count"
      ],
      "properties": {
        "blocked_minutes": {"type": "integer", "minimum": 0},
        "rework_required": {"type": "boolean"},
        "human_intervention": {"type": "boolean"},
        "affected_work_unit_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "structuredObservation": {
      "type": "object",
      "required": [
        "observation_ref",
        "category",
        "severity",
        "origin",
        "confidence",
        "impact",
        "status"
      ],
      "properties": {
        "observation_ref": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "origin": {"type": ["string", "null"]},
        "confidence": {"type": ["string", "null"]},
        "impact": {"$ref": "#/$defs/structuredImpact"},
        "recurrence_ref": {"type": ["string", "null"]},
        "occurrence_count": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "structuredRetrospective": {
      "type": "object",
      "required": ["retrospective_ref", "scope_type", "status"],
      "properties": {
        "retrospective_ref": {"type": "string", "minLength": 1},
        "scope_type": {"type": ["string", "null"]},
        "observation_summary": {"type": "object"},
        "signals": {"type": "object"},
        "status": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "structuredExecution": {
      "type": "object",
      "required": [
        "attempt_ref",
        "step",
        "status",
        "duration_ms"
      ],
      "properties": {
        "attempt_ref": {"type": "string", "minLength": 1},
        "execution_ref": {"type": ["string", "null"]},
        "run_ref": {"type": ["string", "null"]},
        "work_unit_ref": {"type": ["string", "null"]},
        "step": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "role_id": {"type": ["string", "null"]},
        "procedure_id": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "usage": {"type": "object"}
      },
      "additionalProperties": false
    },
    "fullObservation": {
      "type": "object",
      "required": [
        "id",
        "recorded_at",
        "category",
        "severity",
        "symptom",
        "classification",
        "impact",
        "status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^OBS-[A-Za-z0-9._-]+$"},
        "recorded_at": {"type": "string"},
        "category": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "symptom": {"type": "string", "minLength": 1},
        "classification": {"type": "object"},
        "impact": {"type": "object"},
        "status": {"type": "string", "minLength": 1},
        "occurrence_count": {"type": "integer", "minimum": 1},
        "last_recorded_at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "fullRetrospective": {
      "type": "object",
      "required": ["id", "generated_at", "scope", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^RET-[A-Za-z0-9._-]+$"},
        "generated_at": {"type": "string"},
        "scope": {"type": "object"},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "fullExecution": {
      "type": "object",
      "required": ["id", "step", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "step": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
