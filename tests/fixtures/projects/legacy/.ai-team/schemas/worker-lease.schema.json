{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerLease",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "work_unit_id",
    "worker_id",
    "epoch",
    "status",
    "heartbeat_at",
    "stalled_after_minutes",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LEASE-[A-Za-z0-9._-]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-Za-z0-9._-]+$"
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "revoked",
        "released"
      ]
    },
    "heartbeat_at": {
      "type": "string",
      "minLength": 1
    },
    "stalled_after_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "released_at": {
      "type": ["string", "null"]
    },
    "release_reason": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
