{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "type": "object",
  "required": [
    "id",
    "type",
    "command_or_observation",
    "result",
    "demonstrates",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "work_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string"
    },
    "code_revision": {
      "description": "Standalone persists a git SHA string. Ensemble product evidence uses kind composition. Both remain valid.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "kind",
            "sha"
          ],
          "properties": {
            "kind": {
              "const": "git_commit"
            },
            "sha": {
              "type": "string",
              "minLength": 1
            },
            "member_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "composition_id"
          ],
          "properties": {
            "kind": {
              "const": "composition"
            },
            "composition_id": {
              "type": "string",
              "pattern": "^CR-[A-Za-z0-9._-]+$"
            },
            "members": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "command_or_observation": {
      "type": "string"
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ]
    },
    "demonstrates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
