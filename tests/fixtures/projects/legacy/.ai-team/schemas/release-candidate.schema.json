{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleaseCandidate",
  "type": "object",
  "required": [
    "id",
    "status",
    "code_revisions",
    "included_work_units",
    "rollback_plan",
    "target_environment",
    "g3",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "not_ready",
        "ready_for_g3",
        "approved",
        "released",
        "rolled_back",
        "rejected"
      ]
    },
    "code_revisions": {
      "type": "array",
      "minItems": 1
    },
    "included_work_units": {
      "type": "array"
    },
    "rollback_plan": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "target_environment": {
      "type": "string"
    },
    "g3": {
      "type": "object"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
