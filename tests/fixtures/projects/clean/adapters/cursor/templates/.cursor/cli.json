{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:add*)",
      "Shell(git:commit*)",
      "Shell(git:rev-parse*)",
      "Shell(git:merge-base*)",
      "Shell(git:branch*)",
      "Shell(Get-ChildItem:*)",
      "Shell(Select-String:*)",
      "Shell(Test-Path:*)",
      "Shell(Get-Content:*)",
      "Shell(Write-Output:*)",
      "Shell(Get-Location:*)",
      "Shell(Get-Date:*)",
      "Shell(pwd)",
      "Shell(ls:*)",
      "Shell(python:scripts/ai-team/validate.py*)",
      "Shell(python:scripts/ai-team/status.py*)",
      "Shell(python:scripts/ai-team/diagnose.py*)",
      "Shell(python:scripts/ai-team/preflight.py*)",
      "Shell(python:scripts/ai-team/check_done.py*)",
      "Shell(python:scripts/ai-team/propose_allowlist.py*)",
      "Shell(python:scripts/ai-team/feedback.py*)",
      "Shell(python:scripts/ai-team/read_docx.py*)",
      "Shell(python3:scripts/ai-team/validate.py*)",
      "Shell(python3:scripts/ai-team/status.py*)",
      "Shell(python3:scripts/ai-team/diagnose.py*)",
      "Shell(python3:scripts/ai-team/preflight.py*)",
      "Shell(python3:scripts/ai-team/check_done.py*)",
      "Shell(python3:scripts/ai-team/propose_allowlist.py*)",
      "Shell(python3:scripts/ai-team/feedback.py*)",
      "Shell(python3:scripts/ai-team/read_docx.py*)",
      "Shell(py:-3 scripts/ai-team/validate.py*)",
      "Shell(py:-3 scripts/ai-team/status.py*)",
      "Shell(py:-3 scripts/ai-team/diagnose.py*)",
      "Shell(py:-3 scripts/ai-team/preflight.py*)",
      "Shell(py:-3 scripts/ai-team/check_done.py*)",
      "Shell(py:-3 scripts/ai-team/propose_allowlist.py*)",
      "Shell(py:-3 scripts/ai-team/feedback.py*)",
      "Shell(py:-3 scripts/ai-team/read_docx.py*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Write(.ai-team/constitution/**)",
      "Write(.cursor/cli.json)",
      "Write(.cursor/hooks.json)",
      "Write(.cursor/permissions.json)",
      "Shell(git:push*--force*)",
      "Shell(git:push*-f*)",
      "Shell(git:reset*--hard*)",
      "Shell(git:commit*--amend*)",
      "Shell(git:rebase*)",
      "Shell(git:branch*-D*)",
      "Shell(git:branch*--delete*--force*)",
      "Shell(git:branch*-d*-f*)",
      "Shell(rm:-rf*)",
      "Shell(kubectl:apply*)",
      "Shell(kubectl:delete*)",
      "Shell(kubectl:patch*)",
      "Shell(kubectl:replace*)",
      "Shell(kubectl:scale*)",
      "Shell(kubectl:rollout*)",
      "Shell(terraform:apply*)",
      "Shell(terraform:destroy*)"
    ]
  }
}
