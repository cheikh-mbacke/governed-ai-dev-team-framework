{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-ai.local/schemas/procedure-revision.schema.json",
  "$comment": "ProcedureRevision (Document 12 §2.3). Namespaced extensions: ^x-[a-z0-9]+(-[a-z0-9]+)+$ (e.g. x-vendor-meta).",
  "title": "ProcedureRevision",
  "type": "object",
  "required": [
    "procedure_id",
    "revision",
    "intent",
    "invocation_mode",
    "required_inputs",
    "steps",
    "required_outputs",
    "invariants"
  ],
  "properties": {
    "procedure_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "invocation_mode": {
      "type": "string",
      "minLength": 1
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(-[a-z0-9]+)+$": true
  },
  "additionalProperties": false
}
