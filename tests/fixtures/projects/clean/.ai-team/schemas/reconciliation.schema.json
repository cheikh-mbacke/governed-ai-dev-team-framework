{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReconciliationBaseline",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "status",
    "scope",
    "human_material",
    "inventory",
    "convergence",
    "decisions",
    "verification",
    "baseline"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["draft", "awaiting_decisions", "approved", "applying", "blocked", "ready", "stale"]
    },
    "scope": {
      "type": "object",
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "human_material": {
      "type": "object",
      "required": [
        "objectives",
        "users",
        "business_rules",
        "constraints",
        "out_of_scope",
        "prior_decisions",
        "acceptance_criteria"
      ],
      "additionalProperties": { "$ref": "#/$defs/materialEntry" }
    },
    "inventory": {
      "type": "object",
      "required": ["generated_at", "entries"],
      "properties": {
        "generated_at": { "type": "string", "minLength": 1 },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/inventoryEntry" } }
      },
      "additionalProperties": false
    },
    "convergence": {
      "type": "array",
      "items": { "$ref": "#/$defs/convergenceEntry" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decisionEntry" }
    },
    "verification": {
      "type": "object",
      "required": ["commands", "blocking_conflicts"],
      "properties": {
        "commands": { "type": "array", "items": { "$ref": "#/$defs/verificationEntry" } },
        "blocking_conflicts": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "baseline": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["algorithm", "digest", "file_count", "verified_at"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "file_count": { "type": "integer", "minimum": 0 },
            "verified_at": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "materialEntry": {
      "type": "object",
      "required": ["status", "source_refs", "note"],
      "properties": {
        "status": { "enum": ["missing", "ambiguous", "sufficient", "not_applicable"] },
        "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inventoryEntry": {
      "type": "object",
      "required": ["path", "kind", "evidence"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["code", "architecture", "test", "data", "dependency", "documentation", "debt", "infrastructure", "other"] },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "convergenceEntry": {
      "type": "object",
      "required": ["id", "subject", "classification", "intent_refs", "evidence", "action", "resolution_status", "verification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["conformant", "adapt", "obsolete_out_of_scope", "conflicting", "undetermined"] },
        "intent_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "string", "minLength": 1 },
        "action": { "enum": ["keep", "migrate", "rewrite", "isolate", "delete", "clarify"] },
        "resolution_status": { "enum": ["planned", "approved", "completed", "waived", "blocked"] },
        "human_approval_ref": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "decisionEntry": {
      "type": "object",
      "required": ["id", "question", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved"] },
        "resolution_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verificationEntry": {
      "type": "object",
      "required": ["command", "status", "evidence"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "not_run", "not_applicable"] },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
