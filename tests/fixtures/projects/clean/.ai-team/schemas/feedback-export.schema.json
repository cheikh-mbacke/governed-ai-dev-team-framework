{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameworkFeedbackExport",
  "type": "object",
  "required": [
    "format_version",
    "export_id",
    "generated_at",
    "detail_level",
    "project_ref",
    "framework_version",
    "constitution_version",
    "summary",
    "observations",
    "retrospectives",
    "executions"
  ],
  "properties": {
    "format_version": {"const": "1.2"},
    "export_id": {"type": "string", "pattern": "^EXP-[A-Za-z0-9._-]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "detail_level": {"enum": ["aggregate", "structured", "full"]},
    "project_ref": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "framework_version": {"type": "string", "minLength": 1},
    "constitution_version": {"type": "string", "minLength": 1},
    "summary": {"type": "object"},
    "observations": {"type": "array", "items": {"type": "object"}},
    "retrospectives": {"type": "array", "items": {"type": "object"}},
    "executions": {"type": "array", "items": {"type": "object"}},
    "transmission": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["pending", "transmitted", "failed", "local_outbox", "skipped"]
        },
        "submitted_at": {"type": ["string", "null"], "format": "date-time"},
        "destination": {"type": ["string", "null"]},
        "ack_id": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
