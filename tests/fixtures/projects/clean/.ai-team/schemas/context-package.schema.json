{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextPackage",
  "type": "object",
  "required": [
    "id",
    "work_unit",
    "role",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "work_unit": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "assembled_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "source_sha256": {
      "type": ["string", "null"],
      "pattern": "^(sha256:[a-f0-9]{64})?$"
    },
    "required_contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completeness_status": {
      "enum": ["complete", "incomplete", null]
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "source",
          "provenance",
          "reason"
        ],
        "properties": {
          "level": {
            "enum": [
              "L0_constitution",
              "L1_project",
              "L2_relevant_zone",
              "L3_work_unit"
            ]
          },
          "source": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "authoritative",
              "derived",
              "observed"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "open_context_requests": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
