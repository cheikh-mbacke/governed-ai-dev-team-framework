{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-ai.local/schemas/role-definition-revision.schema.json",
  "$comment": "RoleDefinitionRevision (Document 12 §2.2). Namespaced extensions: ^x-[a-z0-9]+(-[a-z0-9]+)+$ (e.g. x-vendor-meta).",
  "title": "RoleDefinitionRevision",
  "type": "object",
  "required": [
    "role_id",
    "revision",
    "mandate",
    "writes",
    "capabilities",
    "approval_policy",
    "procedure_refs",
    "model_preference",
    "isolation"
  ],
  "properties": {
    "role_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "mandate": {
      "type": "string",
      "minLength": 1
    },
    "writes": {
      "type": "object",
      "required": [
        "product",
        "authoritative_governance_commands",
        "non_authoritative_signal_commands"
      ],
      "properties": {
        "product": {
          "type": "object",
          "required": ["level", "paths"],
          "properties": {
            "level": {
              "type": "string",
              "minLength": 1
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "authoritative_governance_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_authoritative_signal_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["repository_read", "shell", "network", "external_tools"],
      "properties": {
        "repository_read": {
          "type": "boolean"
        },
        "shell": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "minLength": 1
        },
        "external_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "approval_policy": {
      "type": "object",
      "required": ["mode", "cannot_relax"],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "cannot_relax": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "procedure_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["procedure_id", "revision"],
        "properties": {
          "procedure_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
          }
        },
        "additionalProperties": false
      }
    },
    "model_preference": {
      "type": "string",
      "minLength": 1
    },
    "isolation": {
      "type": "string",
      "minLength": 1
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(-[a-z0-9]+)+$": true
  },
  "additionalProperties": false
}
