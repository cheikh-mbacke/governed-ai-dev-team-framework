{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-ai.local/schemas/bundle-manifest.schema.json",
  "$comment": "Published Contract Bundle manifest (Document 12 §2.1). Namespaced extensions: property names matching ^x-[a-z0-9]+(-[a-z0-9]+)+$ (e.g. x-vendor-meta).",
  "title": "BundleManifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_version",
    "created_at",
    "content_hash",
    "roles",
    "procedures"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._/-]+\\.json$"
      }
    },
    "procedures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._/-]+\\.json$"
      }
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(-[a-z0-9]+)+$": true
  },
  "additionalProperties": false
}
