# Installed-target layout must not appear on framework_source repositories
.ai-team/runtime/
.ai-team/installation-record.json

# Client feedback loop artifacts (belong on installed projects, not the source repo)
.ai-team/metrics/framework-feedback-*.json
.ai-team/observations/OBS-*.yaml
.ai-team/retrospectives/RET-*.yaml

# AI-team ephemeral/runtime scratch (installed clients)
.ai-team/logs/*.jsonl
.ai-team/locks/
.ai-team/tmp/
.ai-team/cache/
.ai-team/.transactions/
.ai-team/worktrees/
.ai-team/migration-backups/*
!.ai-team/migration-backups/.gitignore

# Fabrication telemetry (framework_source)
.fabric/logs/*.jsonl
.fabric/locks/
.fabric/tmp/
.fabric/cache/
.fabric/.transactions/

# Python
__pycache__/
*.pyc
.venv/
.test-runtime/
.pytest_cache/
.ruff_cache/

# OS/editor
.DS_Store
Thumbs.db

# Local workspace copy and temp install dirs
workspace/
tmp*/
