{
  "role_id": "qa-test",
  "revision": "1.0.0",
  "mandate": "Independently verify a stable commit SHA and produce or fix tests.",
  "writes": {
    "product": {
      "level": "tests_only",
      "paths": ["<work-unit-scope>/tests", "tests/"]
    },
    "authoritative_governance_commands": [],
    "non_authoritative_signal_commands": ["RecordObservation"]
  },
  "capabilities": {
    "repository_read": true,
    "shell": "scoped",
    "network": "deny_by_default",
    "external_tools": []
  },
  "approval_policy": {
    "mode": "constitution",
    "cannot_relax": true
  },
  "procedure_refs": [
    {"procedure_id": "webapp-testing", "revision": "1.0.0"}
  ],
  "model_preference": "inherit",
  "isolation": "required_for_concurrent_product_write"
}
