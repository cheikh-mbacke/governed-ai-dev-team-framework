{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkUnit",
  "type": "object",
  "required": [
    "id",
    "title",
    "objective",
    "scope",
    "expected_behavior",
    "acceptance_criteria",
    "dependencies",
    "risk",
    "required_verification",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WU-[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 1
    },
    "zone": {
      "type": "object",
      "required": [
        "area"
      ],
      "properties": {
        "area": {
          "type": "string",
          "enum": [
            "frontend",
            "backend",
            "fullstack",
            "mobile",
            "infra",
            "data",
            "unknown"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "applicable_rules_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_verification": {
      "type": "object",
      "properties": {
        "unit_tests": {
          "type": "boolean"
        },
        "integration_tests": {
          "type": "boolean"
        },
        "contract_tests": {
          "type": "boolean"
        },
        "e2e": {
          "type": "boolean"
        },
        "qa": {
          "type": "boolean"
        },
        "review": {
          "type": "boolean"
        },
        "security_review": {
          "type": "boolean"
        },
        "audit": {
          "type": "boolean"
        },
        "human_acceptance": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "context_package_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "waiting_decision",
        "blocked",
        "verification",
        "review",
        "audit",
        "human_test",
        "remediation_required",
        "done",
        "cancelled"
      ]
    },
    "events": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "outcomes": {
      "type": "object",
      "properties": {
        "review_status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "changes_requested"
          ]
        },
        "audit_status": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "passed",
            "failed"
          ]
        },
        "human_acceptance": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "passed",
            "accepted",
            "partially_accepted",
            "rejected",
            "remediation_required"
          ]
        },
        "critical_open_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defects": {
          "type": "array"
        },
        "audit_findings": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
