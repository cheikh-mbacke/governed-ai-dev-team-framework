{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkUnit",
  "type": "object",
  "required": [
    "id",
    "title",
    "objective",
    "scope",
    "expected_behavior",
    "acceptance_criteria",
    "dependencies",
    "risk",
    "required_verification",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WU-[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 1
    },
    "applicable_rules_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_verification": {
      "type": "object"
    },
    "context_package_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "waiting_decision",
        "blocked",
        "verification",
        "review",
        "audit",
        "human_test",
        "remediation_required",
        "done",
        "cancelled"
      ]
    },
    "events": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "outcomes": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
